@page "/sales-orders"
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Application.DTOs.SalesOrders
@using SmallBusiness.Application.Common.Models
@using SmallBusiness.Domain.Enums
@inject ISalesOrderService SalesOrderService
@rendermode InteractiveServer

<PageTitle>Sales Orders — SBMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Sales Orders</h1>
    <a href="/sales-orders/create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Sales Order
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-5">
                <input type="text" class="form-control" placeholder="Search by SO-Number or Customer..." @bind="_searchRequest.SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_searchRequest.Status" @bind:after="LoadSalesOrdersAsync">
                    <option value="">All Statuses</option>
                    @foreach (var status in Enum.GetValues<SalesOrderStatus>())
                    {
                        <option value="@status">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-outline-secondary" @onclick="ClearFilters">Clear Filters</button>
            </div>
        </div>
    </div>
</div>

@if (_result == null)
{
    <p>Loading...</p>
}
else if (!_result.Items.Any())
{
    <div class="alert alert-info">No sales orders found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered bg-white shadow-sm align-middle">
            <thead class="table-light">
                <tr>
                    <th>Number</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in _result.Items)
                {
                    <tr>
                        <td><a href="/sales-orders/@order.Id" class="fw-bold text-decoration-none">@order.SalesOrderNumber</a></td>
                        <td>
                            <div>@order.CustomerNameSnapshot</div>
                        </td>
                        <td>@order.OrderDate.ToShortDateString()</td>
                        <td>
                            @switch (order.Status)
                            {
                                case SalesOrderStatus.Draft:
                                    <span class="badge bg-secondary">Draft</span>
                                    break;
                                case SalesOrderStatus.Confirmed:
                                    <span class="badge bg-primary">Confirmed</span>
                                    break;
                                case SalesOrderStatus.Completed:
                                    <span class="badge bg-success">Completed</span>
                                    break;
                                case SalesOrderStatus.Cancelled:
                                    <span class="badge bg-dark">Cancelled</span>
                                    break;
                            }
                        </td>
                        <td class="text-end fw-bold">
                            @order.Total.ToString("C")
                        </td>
                        <td class="text-center">
                            <a href="/sales-orders/@order.Id" class="btn btn-sm btn-outline-primary" title="View Details">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (_result.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(_result.Page > 1 ? "" : "disabled")">
                    <button class="page-link" @onclick="() => ChangePage(_result.Page - 1)">Previous</button>
                </li>
                
                <li class="page-item disabled">
                    <span class="page-link">Page @_result.Page of @_result.TotalPages</span>
                </li>

                <li class="page-item @(_result.Page < _result.TotalPages ? "" : "disabled")">
                    <button class="page-link" @onclick="() => ChangePage(_result.Page + 1)">Next</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private SalesOrderSearchRequest _searchRequest = new() { PageSize = 10 };
    private PagedResult<SalesOrderDto>? _result;
    private System.Timers.Timer? _debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadSalesOrdersAsync();
    }

    private async Task LoadSalesOrdersAsync()
    {
        _result = await SalesOrderService.GetSalesOrdersAsync(_searchRequest);
    }

    private void HandleSearch(KeyboardEventArgs e)
    {
        if (_debounceTimer != null)
        {
            _debounceTimer.Stop();
            _debounceTimer.Dispose();
        }

        _debounceTimer = new System.Timers.Timer(400);
        _debounceTimer.Elapsed += async (s, args) =>
        {
            _searchRequest.PageNumber = 1;
            await InvokeAsync(LoadSalesOrdersAsync);
            await InvokeAsync(StateHasChanged);
        };
        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();
    }

    private async Task ChangePage(int page)
    {
        _searchRequest.PageNumber = page;
        await LoadSalesOrdersAsync();
    }

    private async Task ClearFilters()
    {
        _searchRequest = new SalesOrderSearchRequest { PageSize = 10 };
        await LoadSalesOrdersAsync();
    }
}
