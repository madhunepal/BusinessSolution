@page "/jobs/edit/{Id:guid}"
@using SmallBusiness.Application.DTOs.Customers
@using SmallBusiness.Application.DTOs.Jobs
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Domain.Enums
@inject IJobService JobService
@inject ICustomerService CustomerService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Edit Job</PageTitle>

<div class="mb-4">
    <a href="/jobs/@Id" class="btn btn-outline-secondary">&larr; Back to Job</a>
</div>

<h1>Edit Job</h1>

@if (_job == null)
{
    <p><em>Loading...</em></p>
}
else if (_job.Status == JobStatus.Completed || _job.Status == JobStatus.Cancelled)
{
    <div class="alert alert-warning">This job is @(_job.Status) and cannot be edited.</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <EditForm Model="_request" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />
                
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger">@_errorMessage</div>
                }

                @if (_job.Status == JobStatus.Draft)
                {
                    <div class="mb-3">
                        <label class="form-label">Customer</label>
                        <InputSelect @bind-Value="_request.CustomerId" class="form-select" disabled="@(_job.SalesOrderId.HasValue)">
                            <option value="">-- Select Customer --</option>
                            @foreach (var c in _customers)
                            {
                                <option value="@c.Id">@c.CustomerNumber - @c.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => _request.CustomerId)" class="text-danger" />
                        @if (_job.SalesOrderId.HasValue)
                        {
                            <small class="text-muted">Customer cannot be changed because this job is linked to a Sales Order.</small>
                        }
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <InputText @bind-Value="_request.Title" class="form-control" />
                        <ValidationMessage For="@(() => _request.Title)" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description (Scope of Work)</label>
                        <InputTextArea @bind-Value="_request.Description" class="form-control" rows="3" />
                        <ValidationMessage For="@(() => _request.Description)" class="text-danger" />
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <strong>Title and Scope</strong> are locked because the job is no longer in Draft status. Tasks and Service Address can still be edited.
                    </div>
                }

                <h4 class="mt-4">Service Address</h4>
                
                <div class="mb-3">
                    <label class="form-label">Street</label>
                    <InputText @bind-Value="_request.ServiceStreet" class="form-control" />
                    <ValidationMessage For="@(() => _request.ServiceStreet)" class="text-danger" />
                </div>
                
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">City</label>
                        <InputText @bind-Value="_request.ServiceCity" class="form-control" />
                        <ValidationMessage For="@(() => _request.ServiceCity)" class="text-danger" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">State</label>
                        <InputText @bind-Value="_request.ServiceState" class="form-control" />
                        <ValidationMessage For="@(() => _request.ServiceState)" class="text-danger" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Postal Code</label>
                        <InputText @bind-Value="_request.ServicePostalCode" class="form-control" />
                        <ValidationMessage For="@(() => _request.ServicePostalCode)" class="text-danger" />
                    </div>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Access Instructions</label>
                    <InputTextArea @bind-Value="_request.AccessInstructions" class="form-control" rows="2" />
                    <ValidationMessage For="@(() => _request.AccessInstructions)" class="text-danger" />
                </div>

                <h4 class="mt-4">Job Tasks</h4>
                <div class="mb-3">
                    @for (int i = 0; i < _request.Tasks.Count; i++)
                    {
                        var index = i;
                        <div class="input-group mb-2">
                            <div class="input-group-text">
                                <InputCheckbox @bind-Value="_request.Tasks[index].IsCompleted" />
                            </div>
                            <InputText @bind-Value="_request.Tasks[index].Description" class="form-control" placeholder="Task description..." />
                            <button type="button" class="btn btn-outline-danger" @onclick="() => RemoveTask(index)">Remove</button>
                        </div>
                    }
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddTask">Add Task</button>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary" disabled="@_isSubmitting">
                        @if (_isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Saving...</span>
                        }
                        else
                        {
                            <span>Save Changes</span>
                        }
                    </button>
                    <a href="/jobs/@Id" class="btn btn-secondary">Cancel</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private JobDto? _job;
    private UpdateJobRequest _request = new();
    private List<CustomerDto> _customers = new();
    private bool _isSubmitting = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _job = await JobService.GetJobAsync(Id);
            
            var pagedCustomers = await CustomerService.GetCustomersAsync(new CustomerSearchRequest { PageSize = 1000 });
            _customers = pagedCustomers.Items;

            _request.CustomerId = _job.CustomerId;
            _request.Title = _job.Title;
            _request.Description = _job.Description;
            _request.Priority = _job.Priority;
            _request.ServiceStreet = _job.ServiceStreet;
            _request.ServiceCity = _job.ServiceCity;
            _request.ServiceState = _job.ServiceState;
            _request.ServicePostalCode = _job.ServicePostalCode;
            _request.ServiceCountry = _job.ServiceCountry;
            _request.AccessInstructions = _job.AccessInstructions;

            _request.Tasks = _job.Tasks.Select(t => new JobTaskRequest
            {
                Id = t.Id,
                Description = t.Description,
                IsCompleted = t.IsCompleted,
                SalesOrderLineId = t.SalesOrderLineId
            }).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = "Could not load job: " + ex.Message;
        }
    }

    private void AddTask()
    {
        _request.Tasks.Add(new JobTaskRequest());
    }

    private void RemoveTask(int index)
    {
        if (index >= 0 && index < _request.Tasks.Count)
        {
            _request.Tasks.RemoveAt(index);
        }
    }

    private async Task HandleSubmit()
    {
        if (_request.CustomerId == Guid.Empty)
        {
            _errorMessage = "Please select a customer.";
            return;
        }

        try
        {
            _isSubmitting = true;
            _errorMessage = null;

            await JobService.UpdateJobAsync(Id, _request);
            NavigationManager.NavigateTo($"/jobs/{Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _isSubmitting = false;
        }
    }
}
