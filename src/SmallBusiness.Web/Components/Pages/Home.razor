@page "/dashboard"
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Dashboard — SBMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Dashboard</h1>
        <p class="text-muted mb-0">Open the core workspaces for your business.</p>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">User Information</h5>
                <AuthorizeView>
                    <Authorized>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Email:</strong> @context.User.Identity?.Name</li>
                            <li><strong>Roles:</strong> @string.Join(", ", context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</li>
                        </ul>
                    </Authorized>
                </AuthorizeView>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-4">
        <a href="/customers" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Customers</h5>
                <p class="text-muted mb-0">Manage customer records and contact details.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/catalog" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Catalog</h5>
                <p class="text-muted mb-0">Maintain products, services, pricing, and inventory setup.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/quotes" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Quotes</h5>
                <p class="text-muted mb-0">Create and manage customer estimates.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/sales-orders" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Sales Orders</h5>
                <p class="text-muted mb-0">Track confirmed orders and fulfillment.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/jobs" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Jobs</h5>
                <p class="text-muted mb-0">Coordinate operational work from orders or direct jobs.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/schedule" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Schedule</h5>
                <p class="text-muted mb-0">Review appointments and assignments.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/invoices" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Invoices</h5>
                <p class="text-muted mb-0">Generate invoices and record payments from invoice details.</p>
            </div>
        </a>
    </div>
    <div class="col-md-4">
        <a href="/inventory" class="card h-100 text-decoration-none text-reset shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Inventory</h5>
                <p class="text-muted mb-0">Monitor stock, movements, and locations.</p>
            </div>
        </a>
    </div>
</div>
