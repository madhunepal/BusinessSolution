@page "/catalog/{Id:guid}"
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Application.DTOs.CatalogItems
@inject ICatalogItemService CatalogItemService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Catalog Item Details — SBMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>
        <a href="/catalog" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-2"></i></a>
        Item Details
    </h1>
    <div>
        <a href="/catalog/edit/@Id" class="btn btn-outline-primary me-2">
            <i class="bi bi-pencil"></i> Edit
        </a>
        @if (_item?.IsActive == true)
        {
            <button class="btn btn-outline-danger" @onclick="DeactivateAsync" disabled="@_isDeactivating">
                @if (_isDeactivating)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <i class="bi bi-trash"></i> <span>Deactivate</span>
                }
            </button>
        }
    </div>
</div>

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (_item == null)
{
    <div class="alert alert-danger">Item not found.</div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Basic Information</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Item Code</dt>
                        <dd class="col-sm-9 fw-bold">@_item.ItemCode</dd>

                        <dt class="col-sm-3">Type</dt>
                        <dd class="col-sm-9">@_item.Type</dd>

                        <dt class="col-sm-3">Name</dt>
                        <dd class="col-sm-9">@_item.Name</dd>

                        <dt class="col-sm-3">Description</dt>
                        <dd class="col-sm-9">@(_item.Description ?? "—")</dd>

                        <dt class="col-sm-3">Status</dt>
                        <dd class="col-sm-9">
                            @if (_item.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Pricing & Billing</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3">Unit</dt>
                        <dd class="col-sm-9">@_item.Unit</dd>

                        <dt class="col-sm-3">Cost</dt>
                        <dd class="col-sm-9">@_item.Cost.ToString("C")</dd>

                        <dt class="col-sm-3">Selling Price</dt>
                        <dd class="col-sm-9 fw-bold">@_item.SellingPrice.ToString("C")</dd>

                        <dt class="col-sm-3">Taxable</dt>
                        <dd class="col-sm-9">
                            @if (_item.Taxable)
                            {
                                <span class="text-success"><i class="bi bi-check-circle-fill"></i> Yes</span>
                            }
                            else
                            {
                                <span class="text-muted"><i class="bi bi-x-circle"></i> No</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
            
            <div class="text-muted small">
                Created: @_item.CreatedAt.ToLocalTime().ToString("g")
                @if (_item.UpdatedAt.HasValue)
                {
                    <br />
                    <span>Last Updated: @_item.UpdatedAt.Value.ToLocalTime().ToString("g")</span>
                }
            </div>
        </div>
        
        <div class="col-lg-4">
            <!-- Future space for Activity Timeline -->
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body text-center text-muted p-5">
                    <i class="bi bi-clock-history fs-1 mb-3 d-block"></i>
                    <p class="mb-0">Activity timeline will appear here in a future update.</p>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private CatalogItemDto? _item;
    private bool _isLoading = true;
    private bool _isDeactivating = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _item = await CatalogItemService.GetCatalogItemAsync(Id);
        }
        catch (KeyNotFoundException)
        {
            _item = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeactivateAsync()
    {
        _isDeactivating = true;
        try
        {
            await CatalogItemService.DeactivateCatalogItemAsync(Id);
            await LoadDataAsync();
        }
        finally
        {
            _isDeactivating = false;
        }
    }
}
