@page "/inventory"
@using Microsoft.AspNetCore.Authorization
@using SmallBusiness.Application.DTOs.Inventory
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Infrastructure.Identity
@inject IInventoryService InventoryService
@attribute [Authorize(Policy = Permissions.InventoryView)]

<PageTitle>Inventory</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Inventory</h1>
    <div>
        <a href="/inventory/locations" class="btn btn-outline-secondary me-2">Manage Locations</a>
    </div>
</div>

@if (_profiles == null)
{
    <p><em>Loading...</em></p>
}
else if (!_profiles.Any())
{
    <div class="alert alert-info">No inventory profiles found. You can enable inventory tracking on individual Product catalog items.</div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Item Code</th>
                        <th>Product</th>
                        <th>On Hand</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _profiles)
                    {
                        var isLowStock = p.TotalQuantityOnHand <= p.ReorderLevel;
                        <tr>
                            <td>@p.ItemCode</td>
                            <td>@p.ItemName</td>
                            <td>
                                @p.TotalQuantityOnHand @p.BaseUnit
                            </td>
                            <td>
                                @if (isLowStock)
                                {
                                    <span class="badge bg-warning text-dark">Low Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                            </td>
                            <td>
                                <a href="/inventory/@p.Id" class="btn btn-sm btn-primary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<InventoryProfileDto>? _profiles;

    protected override async Task OnInitializedAsync()
    {
        _profiles = await InventoryService.GetInventoryProfilesAsync();
    }
}
