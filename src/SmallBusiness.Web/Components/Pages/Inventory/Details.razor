@page "/inventory/{id:guid}"
@using Microsoft.AspNetCore.Authorization
@using SmallBusiness.Application.DTOs.Inventory
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Infrastructure.Identity
@using System.ComponentModel.DataAnnotations
@inject IInventoryService InventoryService
@attribute [Authorize(Policy = Permissions.InventoryView)]
@rendermode InteractiveServer

<PageTitle>Inventory Details</PageTitle>

@if (_profile == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>@_profile.ItemName</h1>
            <p class="text-muted">Item Code: @_profile.ItemCode</p>
        </div>
        
        <div>
            <AuthorizeView Policy="@Permissions.InventoryReceive">
                <button class="btn btn-success me-1" data-testid="inventory-receive-action" @onclick="ShowReceiveModal">Receive</button>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.InventoryAdjust">
                <button class="btn btn-warning me-1" data-testid="inventory-adjust-action" @onclick="ShowAdjustModal">Adjust</button>
                <button class="btn btn-danger me-1" data-testid="inventory-reduce-action" @onclick="ShowReduceModal">Reduce</button>
            </AuthorizeView>
            <AuthorizeView Policy="@Permissions.InventoryTransfer">
                <button class="btn btn-info" data-testid="inventory-transfer-action" @onclick="ShowTransferModal">Transfer</button>
            </AuthorizeView>
        </div>

    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <h5 class="text-muted">Total On Hand</h5>
                    <h2 class="@(_profile.TotalQuantityOnHand <= _profile.ReorderLevel ? "text-danger" : "text-success")">
                        @_profile.TotalQuantityOnHand @_profile.BaseUnit
                    </h2>
                    @if (_profile.TotalQuantityOnHand <= _profile.ReorderLevel)
                    {
                        <span class="badge bg-warning text-dark">Low Stock (Reorder Level: @_profile.ReorderLevel)</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">Configuration</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6 mb-2">
                            <strong>Track Lots:</strong> @(_profile.TrackLots ? "Yes" : "No")
                        </div>
                        <div class="col-6 mb-2">
                            <strong>Track Expiration:</strong> @(_profile.TrackExpiration ? "Yes" : "No")
                        </div>
                        <div class="col-6 mb-2">
                            <strong>Allow Negative:</strong> @(_profile.AllowNegativeStock ? "Yes" : "No")
                        </div>
                        <div class="col-6 mb-2">
                            <strong>Status:</strong> @(_profile.IsActive ? "Active" : "Inactive")
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">Stock by Location/Lot</h5>
        </div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Location</th>
                        <th>Lot Number</th>
                        <th class="text-end">Quantity On Hand</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_stockLevels == null || !_stockLevels.Any())
                    {
                        <tr><td colspan="3" class="text-muted text-center py-3">No stock available.</td></tr>
                    }
                    else
                    {
                        @foreach (var s in _stockLevels)
                        {
                            <tr>
                                <td>@s.LocationName</td>
                                <td>@(s.LotNumber ?? "-")</td>
                                <td class="text-end fw-bold">@s.QuantityOnHand @_profile.BaseUnit</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">Recent Movements</h5>
        </div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Lot</th>
                        <th class="text-end">Quantity</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_movements == null || !_movements.Any())
                    {
                        <tr><td colspan="6" class="text-muted text-center py-3">No movements found.</td></tr>
                    }
                    else
                    {
                        @foreach (var m in _movements.Take(10))
                        {
                            <tr>
                                <td>@m.OccurredAt.ToLocalTime().ToString("g")</td>
                                <td>@m.MovementType</td>
                                <td>@m.LocationName</td>
                                <td>@(m.LotNumber ?? "-")</td>
                                <td class="text-end @(m.Quantity > 0 ? "text-success" : "text-danger")">
                                    @(m.Quantity > 0 ? "+" : "")@m.Quantity
                                </td>
                                <td>@m.Notes</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (_showReceiveModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Receive Stock</h5>
                        <button type="button" class="btn-close" @onclick="HideModals"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="_receiveModel" OnValidSubmit="SubmitReceive">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />
                            
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger">@_errorMessage</div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Location</label>
                                <InputSelect @bind-Value="_receiveModel.InventoryLocationId" class="form-select">
                                    <option value="">-- Select Location --</option>
                                    @foreach (var loc in _locations!)
                                    {
                                        <option value="@loc.Id">@loc.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Quantity (@_profile.BaseUnit)</label>
                                <InputNumber @bind-Value="_receiveModel.Quantity" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <InputText @bind-Value="_receiveModel.Notes" class="form-control" />
                            </div>

                            <div class="modal-footer px-0 pb-0">
                                <button type="button" class="btn btn-secondary" @onclick="HideModals">Cancel</button>
                                <button type="submit" class="btn btn-success" disabled="@_isSubmitting">Receive</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    
    @if (_showReduceModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Record Usage/Waste</h5>
                        <button type="button" class="btn-close" @onclick="HideModals"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="_reduceModel" OnValidSubmit="SubmitReduce">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />
                            
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger">@_errorMessage</div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Type</label>
                                <InputSelect @bind-Value="_reduceType" class="form-select">
                                    <option value="Usage">Usage</option>
                                    <option value="Waste">Waste</option>
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Location</label>
                                <InputSelect @bind-Value="_reduceModel.InventoryLocationId" class="form-select">
                                    <option value="">-- Select Location --</option>
                                    @foreach (var loc in _locations!)
                                    {
                                        <option value="@loc.Id">@loc.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Quantity (@_profile.BaseUnit)</label>
                                <InputNumber @bind-Value="_reduceModel.Quantity" class="form-control" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Reason/Notes</label>
                                <InputText @bind-Value="_reduceModel.Reason" class="form-control" />
                            </div>

                            <div class="modal-footer px-0 pb-0">
                                <button type="button" class="btn btn-secondary" @onclick="HideModals">Cancel</button>
                                <button type="submit" class="btn btn-danger" disabled="@_isSubmitting">Record</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showTransferModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Transfer Stock</h5>
                        <button type="button" class="btn-close" @onclick="HideModals"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="_transferModel" OnValidSubmit="SubmitTransfer">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />
                            
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger">@_errorMessage</div>
                            }

                            <div class="mb-3">
                                <label class="form-label">From Location</label>
                                <InputSelect @bind-Value="_transferModel.SourceLocationId" class="form-select">
                                    <option value="">-- Select Location --</option>
                                    @foreach (var loc in _locations!)
                                    {
                                        <option value="@loc.Id">@loc.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">To Location</label>
                                <InputSelect @bind-Value="_transferModel.DestinationLocationId" class="form-select">
                                    <option value="">-- Select Location --</option>
                                    @foreach (var loc in _locations!)
                                    {
                                        <option value="@loc.Id">@loc.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Quantity (@_profile.BaseUnit)</label>
                                <InputNumber @bind-Value="_transferModel.Quantity" class="form-control" />
                            </div>

                            <div class="modal-footer px-0 pb-0">
                                <button type="button" class="btn btn-secondary" @onclick="HideModals">Cancel</button>
                                <button type="submit" class="btn btn-info" disabled="@_isSubmitting">Transfer</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (_showAdjustModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Adjust Stock</h5>
                        <button type="button" class="btn-close" @onclick="HideModals"></button>
                    </div>
                    <div class="modal-body">
                        <EditForm Model="_adjustModel" OnValidSubmit="SubmitAdjust">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger" />
                            
                            @if (!string.IsNullOrEmpty(_errorMessage))
                            {
                                <div class="alert alert-danger">@_errorMessage</div>
                            }

                            <div class="mb-3">
                                <label class="form-label">Location</label>
                                <InputSelect @bind-Value="_adjustModel.InventoryLocationId" class="form-select">
                                    <option value="">-- Select Location --</option>
                                    @foreach (var loc in _locations!)
                                    {
                                        <option value="@loc.Id">@loc.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Quantity Difference (+/-)</label>
                                <InputNumber @bind-Value="_adjustModel.QuantityDifference" class="form-control" />
                                <div class="form-text">Use negative numbers to decrease stock, positive to increase.</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Reason</label>
                                <InputText @bind-Value="_adjustModel.Reason" class="form-control" />
                            </div>

                            <div class="modal-footer px-0 pb-0">
                                <button type="button" class="btn btn-secondary" @onclick="HideModals">Cancel</button>
                                <button type="submit" class="btn btn-warning" disabled="@_isSubmitting">Adjust</button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private InventoryProfileDto? _profile;
    private List<InventoryStockLevelDto>? _stockLevels;
    private List<InventoryMovementDto>? _movements;
    private List<InventoryLocationDto>? _locations;

    private bool _showReceiveModal;
    private bool _showAdjustModal;
    private bool _isSubmitting;
    private string? _errorMessage;

    private StockReceiptDto _receiveModel = new();
    private StockAdjustmentDto _adjustModel = new();
    private bool _showReduceModal;
    private bool _showTransferModal;
    private string _reduceType = "Usage";
    private StockUsageDto _reduceModel = new();
    private StockTransferDto _transferModel = new();

    private void ShowReduceModal()
    {
        _reduceModel = new StockUsageDto { InventoryProfileId = Id };
        _reduceType = "Usage";
        _errorMessage = null;
        _showReduceModal = true;
    }

    private void ShowTransferModal()
    {
        _transferModel = new StockTransferDto { InventoryProfileId = Id };
        _errorMessage = null;
        _showTransferModal = true;
    }

    private void HideModals()
    {
        _showReceiveModal = false;
        _showAdjustModal = false;
        _showReduceModal = false;
        _showTransferModal = false;
    }

    private async Task SubmitReduce()
    {
        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            if (_reduceType == "Usage")
            {
                await InventoryService.RecordUsageAsync(_reduceModel);
            }
            else
            {
                await InventoryService.RecordWasteAsync(new StockWasteDto 
                { 
                    InventoryProfileId = _reduceModel.InventoryProfileId,
                    InventoryLocationId = _reduceModel.InventoryLocationId,
                    InventoryLotId = _reduceModel.InventoryLotId,
                    Quantity = _reduceModel.Quantity,
                    Reason = _reduceModel.Reason
                });
            }
            HideModals();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitTransfer()
    {
        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            await InventoryService.TransferStockAsync(_transferModel);
            HideModals();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }


    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        _locations = await InventoryService.GetLocationsAsync();
    }

    private async Task LoadDataAsync()
    {
        _profile = await InventoryService.GetInventoryProfileAsync(Id);
        _stockLevels = await InventoryService.GetStockLevelsAsync(Id);
        _movements = await InventoryService.GetMovementHistoryAsync(Id);
    }

    private void ShowReceiveModal()
    {
        _receiveModel = new StockReceiptDto { InventoryProfileId = Id };
        _errorMessage = null;
        _showReceiveModal = true;
    }

    private void ShowAdjustModal()
    {
        _adjustModel = new StockAdjustmentDto { InventoryProfileId = Id };
        _errorMessage = null;
        _showAdjustModal = true;
    }

    

    private async Task SubmitReceive()
    {
        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            await InventoryService.ReceiveStockAsync(_receiveModel);
            HideModals();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task SubmitAdjust()
    {
        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            await InventoryService.AdjustStockAsync(_adjustModel);
            HideModals();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
