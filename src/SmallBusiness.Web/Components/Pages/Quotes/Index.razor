@page "/quotes"
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Application.DTOs.Quotes
@using SmallBusiness.Domain.Enums
@inject IQuoteService QuoteService
@rendermode InteractiveServer

<PageTitle>Quotes — SBMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Quotes</h1>
    <a href="/quotes/create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New Quote
    </a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <EditForm Model="@_searchRequest" OnSubmit="SearchAsync" class="row g-3">
            <div class="col-md-7">
                <input type="text" class="form-control" placeholder="Search quote number or customer name..." @bind="_searchRequest.Query" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="_searchRequest.Status">
                    <option value="">All Statuses</option>
                    <option value="1">Draft</option>
                    <option value="2">Sent</option>
                    <option value="3">Accepted</option>
                    <option value="4">Rejected</option>
                    <option value="5">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">Search</button>
            </div>
        </EditForm>
    </div>
</div>

@if (_isLoading)
{
    <p>Loading quotes...</p>
}
else if (_result == null || !_result.Items.Any())
{
    <div class="alert alert-info">No quotes found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Quote #</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Expires</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var q in _result.Items)
                {
                    <tr>
                        <td>
                            <a href="/quotes/@q.Id" class="text-decoration-none fw-bold">@q.QuoteNumber</a>
                        </td>
                        <td>@q.CustomerNameSnapshot</td>
                        <td>@q.QuoteDate.ToShortDateString()</td>
                        <td>
                            @if (q.ExpirationDate.HasValue)
                            {
                                @if (q.Status == QuoteStatus.Sent && q.ExpirationDate.Value.Date < DateTime.Now.Date)
                                {
                                    <span class="text-danger fw-bold" title="Expired">@q.ExpirationDate.Value.ToShortDateString()</span>
                                }
                                else
                                {
                                    @q.ExpirationDate.Value.ToShortDateString()
                                }
                            }
                        </td>
                        <td class="text-end">@q.Total.ToString("C")</td>
                        <td>
                            @switch (q.Status)
                            {
                                case QuoteStatus.Draft:
                                    <span class="badge bg-secondary">Draft</span>
                                    break;
                                case QuoteStatus.Sent:
                                    <span class="badge bg-primary">Sent</span>
                                    break;
                                case QuoteStatus.Accepted:
                                    <span class="badge bg-success">Accepted</span>
                                    break;
                                case QuoteStatus.Rejected:
                                    <span class="badge bg-danger">Rejected</span>
                                    break;
                                case QuoteStatus.Cancelled:
                                    <span class="badge bg-dark">Cancelled</span>
                                    break;
                            }
                        </td>
                        <td class="text-end">
                            <a href="/quotes/@q.Id" class="btn btn-sm btn-outline-primary">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="d-flex justify-content-between align-items-center mt-3">
        <span class="text-muted">Showing page @_result.Page of @_result.TotalPages (@_result.TotalCount total items)</span>
        <div class="btn-group">
            <button class="btn btn-outline-secondary" disabled="@( _result.Page <= 1 )" @onclick="() => ChangePageAsync(_result.Page - 1)">Previous</button>
            <button class="btn btn-outline-secondary" disabled="@( _result.Page >= _result.TotalPages )" @onclick="() => ChangePageAsync(_result.Page + 1)">Next</button>
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private QuoteSearchRequest _searchRequest = new QuoteSearchRequest();
    private SmallBusiness.Application.Common.Models.PagedResult<QuoteDto>? _result;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task SearchAsync()
    {
        _searchRequest.Page = 1;
        await LoadDataAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        _searchRequest.Page = page;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _result = await QuoteService.GetQuotesAsync(_searchRequest);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
