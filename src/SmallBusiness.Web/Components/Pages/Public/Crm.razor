@page "/crm"

<PageTitle>CRM — SBMS</PageTitle>

<div class="public-hero">
    <div class="container">
        <h1>Customer Relationship Management</h1>
        <p class="lead">Build and nurture customer relationships. Track every interaction from first contact to loyal client.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <h2 class="fw-bold">Manage Your Customer Base</h2>
            <p class="text-muted">
                SBMS CRM gives you a complete view of every customer — contact details, service history, 
                quotes, sales orders, and invoices all linked together. Never lose context on a customer again.
            </p>
            <ul class="list-unstyled">
                <li class="mb-2">✓ Customer profiles with contact & billing details</li>
                <li class="mb-2">✓ Unique customer numbering (auto or manual)</li>
                <li class="mb-2">✓ Activity feed per customer</li>
                <li class="mb-2">✓ Link customers to quotes, orders, jobs & invoices</li>
                <li class="mb-2">✓ Tenant-isolated, secure multi-business support</li>
            </ul>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>Sample Customer List</strong>
                    <span class="badge bg-secondary sample-badge">DEMO DATA</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Number</th><th>Name</th><th>Email</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>CUST-000001</td><td>Acme Properties</td><td>info@@acme.com</td><td><span class="badge bg-success">Active</span></td></tr>
                            <tr><td>CUST-000002</td><td>Greenfield HOA</td><td>manager@@greenfield.org</td><td><span class="badge bg-success">Active</span></td></tr>
                            <tr><td>CUST-000003</td><td>River Tech Corp</td><td>ops@@rivertech.io</td><td><span class="badge bg-success">Active</span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <PublicCta PrimaryText="Open CRM" PrimaryUrl="/customers" />
    </div>
</div>
