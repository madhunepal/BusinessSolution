@page "/sales"

<PageTitle>Sales — SBMS</PageTitle>

<div class="public-hero">
    <div class="container">
        <h1>Sales Management</h1>
        <p class="lead">From catalog to quote to sales order — streamline your entire sales cycle.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <h2 class="fw-bold">Full Sales Pipeline</h2>
            <p class="text-muted">
                Maintain a product & service catalog, generate quotes for customers, convert accepted quotes 
                into confirmed sales orders, and track every stage of the deal.
            </p>
            <ul class="list-unstyled">
                <li class="mb-2">✓ Product & service catalog with pricing</li>
                <li class="mb-2">✓ Professional quotes with line items</li>
                <li class="mb-2">✓ Quote → Sales Order conversion</li>
                <li class="mb-2">✓ Direct sales orders (no quote required)</li>
                <li class="mb-2">✓ Immutable financial snapshots on conversion</li>
                <li class="mb-2">✓ Deterministic pricing — no surprise recalculations</li>
            </ul>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <strong>Sample Quote Pipeline</strong>
                    <span class="badge bg-secondary sample-badge">DEMO DATA</span>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Quote #</th><th>Customer</th><th>Total</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>QUOTE-000012</td><td>Acme Properties</td><td>$4,250.00</td><td><span class="badge bg-success">Accepted</span></td></tr>
                            <tr><td>QUOTE-000013</td><td>Greenfield HOA</td><td>$1,800.00</td><td><span class="badge bg-primary">Sent</span></td></tr>
                            <tr><td>QUOTE-000014</td><td>River Tech Corp</td><td>$6,500.00</td><td><span class="badge bg-secondary">Draft</span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center">
        <a href="/Account/Register" class="btn btn-primary btn-lg me-2">Get Started</a>
        <a href="/Account/Login" class="btn btn-outline-primary btn-lg">Log in</a>
    </div>
</div>
