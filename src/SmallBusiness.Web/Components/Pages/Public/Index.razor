@page "/"

<PageTitle>SBMS — Small Business Management System</PageTitle>

<div class="public-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1>Small Business Management System</h1>
                <p class="lead mt-3">
                    Manage your customers, quotes, sales orders, jobs, scheduling, and invoicing — all in one place.
                    Built for service-based small businesses.
                </p>
                <div class="mt-4 d-flex gap-3">
                    <PublicCta PrimaryCss="btn btn-light btn-lg" SecondaryCss="btn btn-outline-light btn-lg" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Everything You Need to Run Your Business</h2>
        <p class="text-muted">Six integrated modules designed for field service and trade professionals.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card module-card h-100">
                <div class="card-body text-center p-4">
                    <div class="module-icon text-primary">
                        <span class="bi bi-people-fill"></span>
                    </div>
                    <h5 class="card-title">CRM</h5>
                    <p class="card-text text-muted">
                        Track customers, leads, and contacts. Build lasting relationships with a complete customer history.
                    </p>
                    <a href="/crm" class="btn btn-outline-primary btn-sm">Learn More</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card module-card h-100">
                <div class="card-body text-center p-4">
                    <div class="module-icon text-success">
                        <span class="bi bi-file-earmark-text-fill"></span>
                    </div>
                    <h5 class="card-title">Sales</h5>
                    <p class="card-text text-muted">
                        Create quotes, convert to sales orders, and track your pipeline from prospect to closed deal.
                    </p>
                    <a href="/sales" class="btn btn-outline-success btn-sm">Learn More</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card module-card h-100">
                <div class="card-body text-center p-4">
                    <div class="module-icon text-warning">
                        <span class="bi bi-tools"></span>
                    </div>
                    <h5 class="card-title">Operations</h5>
                    <p class="card-text text-muted">
                        Manage jobs, tasks, and work orders. Track progress from assignment to completion.
                    </p>
                    <a href="/operations" class="btn btn-outline-warning btn-sm">Learn More</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card module-card h-100">
                <div class="card-body text-center p-4">
                    <div class="module-icon text-info">
                        <span class="bi bi-calendar-event"></span>
                    </div>
                    <h5 class="card-title">Scheduling</h5>
                    <p class="card-text text-muted">
                        Coordinate appointments, assign technicians, and manage your team's availability in real-time.
                    </p>
                    <a href="/scheduling" class="btn btn-outline-info btn-sm">Learn More</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card module-card h-100">
                <div class="card-body text-center p-4">
                    <div class="module-icon text-danger">
                        <span class="bi bi-receipt"></span>
                    </div>
                    <h5 class="card-title">Finance</h5>
                    <p class="card-text text-muted">
                        Issue invoices, track payments, and manage cash flow with built-in financial tooling.
                    </p>
                    <a href="/finance" class="btn btn-outline-danger btn-sm">Learn More</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card module-card h-100">
                <div class="card-body text-center p-4">
                    <div class="module-icon text-secondary">
                        <span class="bi bi-box-seam-fill"></span>
                    </div>
                    <h5 class="card-title">Catalog</h5>
                    <p class="card-text text-muted">
                        Maintain your product and service catalog with pricing, units, and tax configuration.
                    </p>
                    <a href="/sales" class="btn btn-outline-secondary btn-sm">Learn More</a>
                </div>
            </div>
        </div>
    </div>
</div>
