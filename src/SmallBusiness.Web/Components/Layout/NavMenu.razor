@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">SBMS</a>
    </div>
</div>

<button type="button"
        class="navbar-toggler"
        aria-label="Toggle navigation"
        aria-controls="authenticated-navigation"
        aria-expanded="@MobileMenuExpanded"
        @onclick="ToggleMobileMenu">
    <span class="navbar-toggler-icon" aria-hidden="true"></span>
</button>

<div id="authenticated-navigation" class="@MobileMenuClass" @onclick="CloseMobileMenu">
    <nav class="flex-column" aria-label="Authenticated navigation">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        @* Sales *@
        <div class="nav-section-header px-3 mt-3">
            <small class="nav-section-label text-uppercase fw-bold">Sales</small>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="customers">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Customers
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="catalog">
                <span class="bi bi-list-ul" aria-hidden="true"></span> Catalog
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="quotes">
                <span class="bi bi-file-earmark-text-fill" aria-hidden="true"></span> Quotes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sales-orders">
                <span class="bi bi-file-earmark-text-fill" aria-hidden="true"></span> Sales Orders
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="invoices">
                <span class="bi bi-receipt" aria-hidden="true"></span> Invoices
            </NavLink>
        </div>

        @* Operations *@
        <div class="nav-section-header px-3 mt-3">
            <small class="nav-section-label text-uppercase fw-bold">Operations</small>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="jobs">
                <span class="bi bi-tools" aria-hidden="true"></span> Jobs
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <a class="@ScheduleNavClass" href="schedule">
                <span class="bi bi-calendar3" aria-hidden="true"></span> Schedule
            </a>
        </div>
        <div class="nav-item px-3">
            <a class="@InventoryNavClass" href="inventory">
                <span class="bi bi-box-seam-fill" aria-hidden="true"></span> Inventory
            </a>
        </div>

        @* Business *@
        <div class="nav-section-header px-3 mt-3">
            <small class="nav-section-label text-uppercase fw-bold">Business</small>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="onboarding/business">
                <span class="bi bi-arrow-left-right" aria-hidden="true"></span> Switch Business
            </NavLink>
        </div>

    </nav>
</div>

@code {
    private bool isMobileMenuOpen;

    private string MobileMenuClass => isMobileMenuOpen
        ? "nav-scrollable show"
        : "nav-scrollable";

    private string MobileMenuExpanded => isMobileMenuOpen ? "true" : "false";

    private string ScheduleNavClass => NavClass("schedule", "appointments");
    private string InventoryNavClass => NavClass("inventory");

    private void ToggleMobileMenu()
    {
        isMobileMenuOpen = !isMobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        isMobileMenuOpen = false;
    }

    private string NavClass(params string[] routePrefixes)
    {
        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/');
        var isActive = routePrefixes.Any(prefix =>
            string.Equals(path, prefix, StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith($"{prefix}/", StringComparison.OrdinalIgnoreCase));

        return isActive ? "nav-link active" : "nav-link";
    }
}
