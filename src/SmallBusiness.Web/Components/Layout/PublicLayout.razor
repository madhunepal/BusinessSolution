@inherits LayoutComponentBase
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Application.Services
@inject ITenantContext TenantContext
@inject BusinessService BusinessService

<div class="public-layout">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <span class="text-primary">SBMS</span> — Small Business Management
            </a>
            <button class="navbar-toggler" type="button" @onclick="TogglePublicMenu"
                aria-controls="publicNavbar" aria-expanded="@PublicMenuExpanded" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="@PublicNavbarClass" id="publicNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="/" @onclick="ClosePublicMenu">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/crm" @onclick="ClosePublicMenu">CRM</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/sales" @onclick="ClosePublicMenu">Sales</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/operations" @onclick="ClosePublicMenu">Operations</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/scheduling" @onclick="ClosePublicMenu">Scheduling</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/finance" @onclick="ClosePublicMenu">Finance</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <AuthorizeView>
                        <Authorized>
                            @if (TenantContext.CurrentBusinessId is not null)
                            {
                                <span class="badge text-bg-light">@(_businessName ?? "Business")</span>
                                <div class="dropdown">
                                    <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button"
                                        @onclick="ToggleAccountMenu"
                                        aria-expanded="@AccountMenuExpanded"
                                        aria-controls="publicAccountMenu">
                                        @context.User.Identity?.Name
                                    </button>
                                    <ul class="@AccountMenuClass" id="publicAccountMenu">
                                        <li><a class="dropdown-item" href="/dashboard" @onclick="CloseMenus">Dashboard</a></li>
                                        <li><a class="dropdown-item" href="/Account/Manage" data-enhance-nav="false" @onclick="CloseMenus">Account/Profile</a></li>
                                        <li><a class="dropdown-item" href="/onboarding/business" @onclick="CloseMenus">Switch Business</a></li>
                                    </ul>
                                </div>
                                <a href="/Account/Logout?returnUrl=%2F" class="btn btn-outline-light btn-sm" data-enhance-nav="false" @onclick="CloseMenus">Log out</a>
                            }
                            else
                            {
                                <a href="/onboarding/business" class="btn btn-outline-light btn-sm" @onclick="ClosePublicMenu">Set up business</a>
                                <a href="/Account/Logout?returnUrl=%2F" class="btn btn-outline-light btn-sm" data-enhance-nav="false" @onclick="ClosePublicMenu">Log out</a>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a href="/Account/Login" class="btn btn-outline-light btn-sm" data-enhance-nav="false" @onclick="ClosePublicMenu">Log in</a>
                            <a href="/Account/Register" class="btn btn-primary btn-sm" data-enhance-nav="false" @onclick="ClosePublicMenu">Get Started</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </nav>

    <main>
        @Body
    </main>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0 text-muted">&copy; @DateTime.Now.Year SBMS — Small Business Management System. All rights reserved.</p>
        </div>
    </footer>
</div>

@code {
    private string? _businessName;
    private bool isPublicMenuOpen;
    private bool isAccountMenuOpen;

    private string PublicNavbarClass => isPublicMenuOpen
        ? "collapse navbar-collapse show"
        : "collapse navbar-collapse";

    private string PublicMenuExpanded => isPublicMenuOpen ? "true" : "false";

    private string AccountMenuClass => isAccountMenuOpen
        ? "dropdown-menu dropdown-menu-end show"
        : "dropdown-menu dropdown-menu-end";

    private string AccountMenuExpanded => isAccountMenuOpen ? "true" : "false";

    protected override async Task OnInitializedAsync()
    {
        if (TenantContext.CurrentBusinessId is not null)
        {
            var result = await BusinessService.GetCurrentBusinessAsync();
            if (result.Succeeded && result.Value is not null)
            {
                _businessName = result.Value.Name;
            }
        }
    }

    private void TogglePublicMenu()
    {
        isPublicMenuOpen = !isPublicMenuOpen;
        if (!isPublicMenuOpen)
        {
            isAccountMenuOpen = false;
        }
    }

    private void ClosePublicMenu()
    {
        isPublicMenuOpen = false;
        isAccountMenuOpen = false;
    }

    private void ToggleAccountMenu()
    {
        isAccountMenuOpen = !isAccountMenuOpen;
    }

    private void CloseMenus()
    {
        isPublicMenuOpen = false;
        isAccountMenuOpen = false;
    }
}
