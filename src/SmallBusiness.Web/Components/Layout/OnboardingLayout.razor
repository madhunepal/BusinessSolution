@inherits LayoutComponentBase

<div class="onboarding-layout min-vh-100 bg-light">
    <header class="border-bottom bg-white">
        <div class="container py-3 d-flex justify-content-between align-items-center gap-3">
            <a class="navbar-brand fw-bold text-decoration-none" href="/">
                <span class="text-primary">SBMS</span> <span class="text-dark">Small Business Management</span>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="/" class="btn btn-outline-secondary btn-sm">Back to Home</a>
                <a href="/Account/Logout?returnUrl=%2F" class="btn btn-outline-danger btn-sm" data-enhance-nav="false">Sign out</a>
            </div>
        </div>
    </header>

    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                @Body
            </div>
        </div>
    </main>
</div>
