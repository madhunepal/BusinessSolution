@rendermode InteractiveServer

@using Microsoft.AspNetCore.Identity
@using SmallBusiness.Infrastructure.Identity
@using SmallBusiness.Application.Interfaces
@using SmallBusiness.Application.Services
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject IApplicationDbContext DbContext
@inject ITenantContext TenantContext
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BusinessService BusinessService
@inject ILogger<BusinessSelector> Logger

<div class="card shadow-sm business-selector-card">
    <div class="card-header bg-warning-subtle">
        <h5 class="mb-0">@(OnboardingMode ? "Set up your business" : "Select or Create a Business")</h5>
    </div>
    <div class="card-body">
        @if (_isLoading)
        {
            <p>Loading your businesses...</p>
        }
        else if (_userBusinesses.Any())
        {
            <p>You have access to the following businesses. Please select one to continue:</p>
            <div class="list-group mb-4">
                @foreach (var bu in _userBusinesses)
                {
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" @onclick="() => NavigateToBusinessSelection(bu.BusinessId)">
                        <span>
                            <strong>@bu.Business.Name</strong> 
                            <span class="badge bg-secondary ms-2">Role: @bu.Role</span>
                        </span>
                        <i class="bi bi-chevron-right"></i>
                    </button>
                }
            </div>
        }
        else
        {
            <p>@(OnboardingMode ? "Create your first business workspace to continue." : "You do not belong to any business yet.")</p>
        }

        <hr />
        
        <h6>Create a New Business</h6>
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger" role="alert">@_errorMessage</div>
        }
        <form @onsubmit="CreateBusinessAsync" @onsubmit:preventDefault="true" class="d-flex gap-2">
            <input type="text" class="form-control" placeholder="Business Name" @bind="_newBusinessName" required disabled="@_isSubmitting" />
            <button type="button" class="btn btn-success" @onclick="CreateBusinessAsync" disabled="@_isSubmitting">
                @(_isSubmitting ? "Creating..." : "Create")
            </button>
        </form>
    </div>
</div>

@code {
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string? _errorMessage;
    private List<SmallBusiness.Domain.Entities.BusinessUser> _userBusinesses = new();
    private string _newBusinessName = "";
    
    [Parameter]
    public bool OnboardingMode { get; set; }

    [Parameter]
    public string? SuccessUrl { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadBusinessesAsync();
    }

    private async Task LoadBusinessesAsync()
    {
        _isLoading = true;
        try
        {
            var user = await GetPrincipalAsync();
            var userId = user?.FindFirstValue(ClaimTypes.NameIdentifier);
            if (userId != null)
            {
                // Use IgnoreQueryFilters because the global query filter currently filters by CurrentBusinessId
                // and we need to find businesses the user belongs to REGARDLESS of current active context.
                _userBusinesses = await DbContext.BusinessUsers
                    .IgnoreQueryFilters()
                    .Include(bu => bu.Business)
                    .Where(bu => bu.UserId == userId && bu.IsActive)
                    .ToListAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load businesses for the current user.");
            _errorMessage = "We couldn't load your businesses. Please refresh and try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void NavigateToBusinessSelection(Guid businessId)
    {
        var returnUrl = Uri.EscapeDataString(SuccessUrl ?? "/dashboard");
        NavigationManager.NavigateTo($"/Account/SelectBusiness?businessId={businessId}&returnUrl={returnUrl}", forceLoad: true);
    }

    private async Task CreateBusinessAsync()
    {
        if (_isSubmitting) return;
        if (string.IsNullOrWhiteSpace(_newBusinessName)) return;

        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var principal = await GetPrincipalAsync();
            var userId = principal?.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrWhiteSpace(userId))
            {
                _errorMessage = "Please sign in before creating a business.";
                return;
            }

            var result = await BusinessService.CreateBusinessForUserAsync(userId, _newBusinessName);
            if (!result.Succeeded)
            {
                _errorMessage = result.Errors.FirstOrDefault() ?? "We couldn't create your business. Please try again.";
                return;
            }

            _newBusinessName = "";
            NavigateToBusinessSelection(result.Value);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to create the first business for the current user.");
            _errorMessage = "We couldn't create your business. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task<ClaimsPrincipal?> GetPrincipalAsync()
    {
        if (AuthState is not null)
        {
            return (await AuthState).User;
        }

        return (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
    }

}
